# ========================
# Application Settings
# ========================
APP_NAME=EnergyPredictionSystem
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
SECRET_KEY=your-secret-key-change-in-production
API_VERSION=v1

# ========================
# Backend (FastAPI)
# ========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
VITE_API_URL=/api

# ========================
# PostgreSQL
# ========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=energy_prediction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/energy_prediction
# Used only by automated integration tests running from the host.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/energy_prediction_test

# ========================
# Redis
# ========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# JWT Authentication
# ========================
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# Celery
# ========================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ========================
# ML Service
# ========================
MODEL_ARTIFACTS_PATH=/app/ml_service/artifacts
MODEL_RETRAIN_SCHEDULE_HOURS=24
PREDICTION_CACHE_TTL_SECONDS=300
PRODUCTION_MODEL_MANIFEST=models/production/current.json

# ========================
# External APIs
# ========================
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ========================
# Notifications
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMS_API_KEY=your-sms-api-key
